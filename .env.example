# Postgres. The database is created on first boot when it does not exist.
DATABASE_URL=postgres://USER:PASSWORD@srv-captain--postgres:5432/orario

# Public address of the site
SITE_URL=https://orario.me

# Email reminders (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Orario <lembretes@orario.me>"

# WhatsApp reminders (Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# SMS reminders (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: path of a file with KEY=VALUE lines (same names as above),
# for keeping secrets out of the app configuration.
ORARIO_ENV_FILE=

# Comma-separated emails that can open the admin panel at /pt/admin
ADMIN_EMAILS=
